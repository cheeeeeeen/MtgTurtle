# DeepSeek API Key（本地开发用）
# 前往 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=sk-your-key-here

# 海龟汤模式密钥签名密钥
# 服务端脚本 (generate-key.ts) 使用 MTG_SIGNING_SECRET
# 客户端代码 (keys.ts) 需要使用 VITE_ 前缀暴露给浏览器
# 两者请设为相同的值
MTG_SIGNING_SECRET=change-me-to-a-random-string
VITE_MTG_SIGNING_SECRET=change-me-to-a-random-string
